CHROMA_DB_PATH=data/chroma_db
STANDARDS_DIR=data/standards
UPLOADS_DIR=data/uploads

# Local narrative generation (Layer 5) — no API key needed.
# Backend auto-detects: mlx on Apple Silicon, llama.cpp (GGUF, portable) elsewhere
# (e.g. Hugging Face Spaces). Override with LLM_BACKEND=mlx|llama_cpp if needed.
# LLM_BACKEND=llama_cpp

# mlx backend (Apple Silicon)
LOCAL_LLM_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit

# llama.cpp backend (portable CPU, e.g. HF Spaces)
LOCAL_LLM_GGUF_REPO=Qwen/Qwen2.5-7B-Instruct-GGUF
LOCAL_LLM_GGUF_FILE=qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf
LOCAL_LLM_GGUF_ADDITIONAL_FILES=qwen2.5-7b-instruct-q4_k_m-00002-of-00002.gguf
LOCAL_LLM_CTX_TOKENS=4096
# LOCAL_LLM_N_THREADS=4               # override if os.cpu_count() misreports
# LOCAL_LLM_N_GPU_LAYERS=-1           # -1 = offload all layers; only set where a GPU is actually attached
# LOCAL_LLM_N_WORKERS=2               # >1 = that many independent model instances processing flags concurrently
#                                      # (llama_cpp backend only); LOCAL_LLM_N_THREADS is split evenly across
#                                      # them, so raise both together or you'll under-utilize the CPU
# LOCAL_LLM_SPECULATIVE_DECODING=1    # default 0 (off) — confirmed broken on llama-cpp-python 0.3.x, crashes
#                                      # every call (see config.py). Only set 1 to re-test after a library upgrade.
# LOCAL_LLM_USE_TEMPLATES=0           # default 1 (on) — observation/recommendation/standard_reference built
#                                      # deterministically from flag evidence instead of asking the model to
#                                      # write them (see pipeline/generator/templates.py). Set 0 to force every
#                                      # flag through the old full-generation LLM call instead.
# LOCAL_LLM_NARRATIVE_ADDENDUM=0      # default 1 (on) — only relevant when templates are on: makes one small
#                                      # LLM call per flag to check whether the note text explains the templated
#                                      # fact, adding a sentence if not. Set 0 to skip the model entirely and get
#                                      # templates-only output (fastest, but loses that one qualitative check).

LOCAL_LLM_MAX_TOKENS=800
LOCAL_LLM_TEMPERATURE=0.0
