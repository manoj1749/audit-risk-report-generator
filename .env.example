CHROMA_DB_PATH=data/chroma_db
STANDARDS_DIR=data/standards
UPLOADS_DIR=data/uploads

# Local narrative generation (Layer 5) — no API key needed.
# Backend auto-detects: mlx on Apple Silicon, llama.cpp (GGUF, portable) elsewhere
# (e.g. Hugging Face Spaces). Override with LLM_BACKEND=mlx|llama_cpp if needed.
# LLM_BACKEND=llama_cpp

# mlx backend (Apple Silicon)
LOCAL_LLM_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit

# llama.cpp backend (portable CPU, e.g. HF Spaces)
LOCAL_LLM_GGUF_REPO=Qwen/Qwen2.5-7B-Instruct-GGUF
LOCAL_LLM_GGUF_FILE=qwen2.5-7b-instruct-q4_k_m.gguf
LOCAL_LLM_CTX_TOKENS=4096

LOCAL_LLM_MAX_TOKENS=800
LOCAL_LLM_TEMPERATURE=0.0
