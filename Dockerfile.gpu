# GPU build for Cloud Run (asia-southeast1 only -- confirmed via a real
# --no-traffic test deploy that this project has RTX Pro 6000 quota there;
# us-central1 keeps the plain CPU Dockerfile as the stable fallback, entirely
# unaffected by this file). RTX Pro 6000 is Blackwell architecture, compute
# capability 12.2 (sm_122) -- confirmed directly against the card's own
# reported CUDA capability, not just a generic "Blackwell" assumption. CUDA
# 12.8 is the documented minimum for any Blackwell (sm_100/120-family)
# support at all, so this must be 12.8+, not whatever CUDA the CPU image
# would have defaulted to.
#
# Scope for this first pass: only the LLM (llama-cpp-python) gets a CUDA
# build. PaddleOCR and the embedding model (sentence-transformers/torch)
# stay on their existing CPU builds deliberately -- PyTorch's own issue
# tracker still had an open ticket for full RTX Pro 6000/sm_122 support at
# the time this was written, so stacking multiple libraries' uncertain
# Blackwell compatibility into one build risks the whole image failing for
# uncertain gain. The LLM is also the single biggest win on its own: GPU
# memory bandwidth is what actually removes the CPU decode bottleneck
# documented in deploy.sh (N_WORKERS>1 didn't help on CPU because decoding is
# memory-bandwidth-bound, not core-bound).
FROM nvidia/cuda:12.8.0-devel-ubuntu22.04

# Ubuntu 22.04 ships Python 3.10; deadsnakes PPA for the same 3.11 already
# validated on the CPU image, to keep behavior identical elsewhere.
# DEBIAN_FRONTEND=noninteractive: without this, installing/upgrading tzdata
# (a transitive dependency pulled in here) prompts for a geographic-area
# selection via debconf and hangs forever in Cloud Build's non-interactive
# shell -- confirmed directly, wasted a full build attempt before this was
# added.
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-dev \
    libgl1 libglib2.0-0 libgomp1 poppler-utils unzip curl \
    build-essential cmake \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    LLM_BACKEND=llama_cpp \
    GRADIO_SERVER_NAME=0.0.0.0

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    # Embedding model (sentence-transformers) stays CPU-only -- see file
    # header for why. Same reasoning as the CPU Dockerfile: install the CPU
    # wheel first so pip doesn't default to pulling the CUDA build.
    && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir gdown

# CUDA-enabled llama-cpp-python, built from source against this image's CUDA
# toolkit. CMAKE_CUDA_ARCHITECTURES=120 (not 122): 120 is the well-established,
# broadly-supported Blackwell workstation target as of CUDA 12.8, and CUDA's
# PTX forward-compatibility within the same architecture family means a
# compute_120 build JITs cleanly on sm_122 hardware at first run (a one-time,
# brief JIT cost) even without an exact sm_122 binary -- a safer bet than
# targeting the newer, less broadly-validated 122 value directly for a first
# GPU build of this app. --force-reinstall/--no-cache-dir: the CPU wheel from
# the requirements.txt install above must not be reused.
RUN CMAKE_ARGS="-DGGML_CUDA=on -DCMAKE_CUDA_ARCHITECTURES=120" \
    FORCE_CMAKE=1 \
    pip install --no-cache-dir --force-reinstall --no-binary llama-cpp-python llama-cpp-python

# Everything below downloads several GB (standards corpus + ~4.7GB LLM +
# embedding model) and depends on nothing but pip packages already
# installed above -- deliberately placed BEFORE `COPY . .`, same reasoning
# as the CPU Dockerfile (see its comment): keeps Docker's layer cache valid
# across ordinary code-only deploys.
ARG STANDARDS_INDEX_DRIVE_ID=1hdLopPijZDlzZNNcFlFcA3cDqTVrrwe6
RUN gdown "https://drive.google.com/uc?id=${STANDARDS_INDEX_DRIVE_ID}" -O /tmp/standards.zip \
    && unzip -q -o /tmp/standards.zip -d /app \
    && rm -f /tmp/standards.zip \
    && test -f /app/data/chroma_db/chroma.sqlite3

RUN mkdir -p /app/models && python -c "\
from huggingface_hub import hf_hub_download; \
hf_hub_download(repo_id='Qwen/Qwen2.5-7B-Instruct-GGUF', filename='qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf', local_dir='/app/models'); \
hf_hub_download(repo_id='Qwen/Qwen2.5-7B-Instruct-GGUF', filename='qwen2.5-7b-instruct-q4_k_m-00002-of-00002.gguf', local_dir='/app/models')"
RUN python -c "\
from sentence_transformers import SentenceTransformer; \
SentenceTransformer('BAAI/bge-m3')"
ENV LOCAL_LLM_MODEL_PATH=/app/models/qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf

# Application source last -- same reasoning as the CPU Dockerfile.
COPY . .

# Cloud Run injects $PORT (default 8080) and expects the server bound to it on
# 0.0.0.0 -- app.py reads $PORT itself, this EXPOSE is documentation only.
EXPOSE 8080

CMD ["python", "app.py"]
